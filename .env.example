# Flask configuration
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=false

# Server
PORT=5000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=30 per minute

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Image processing
MAX_CONTENT_LENGTH=10485760
MAX_IMAGE_DIMENSION=4000
